# Install peer dependencies only when they are listed in package.json, the way package-lock.json
# was generated. next-sanity lists the whole `sanity` Studio package as a peer, but this app only
# uses next-sanity's data fetching and Visual Editing (the Studio is a separate package in studio/),
# so the Studio's dependency tree is not installed here. styled-components, which Visual Editing
# needs, is a direct dependency.
legacy-peer-deps=true
