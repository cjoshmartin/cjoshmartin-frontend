  },
  "dependencies": {
    "@sanity/client": "8.17.0",
    "@sanity/functions": "1.11.1",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "groq-js": "2.0.3",
    "tsx": "4.23.15",
